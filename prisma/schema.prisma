generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  mitra
}

enum VarietasJagung {
  NK212
  Bisi_18    @map("Bisi-18")
  Pioneer_P27 @map("Pioneer P27")
}

enum StatusSiklus {
  perencanaan
  persiapan_lahan
  penanaman
  perawatan
  panen
  selesai
  gagal
}

enum StatusIrigasi {
  dijadwalkan
  selesai
  dibatalkan
  terlewat
}

enum KategoriBiaya {
  benih
  pupuk
  pestisida
  tenaga_kerja
  irigasi
  alat
  lainnya
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  authId    String   @unique @map("auth_id") @db.Uuid
  nama      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  role      UserRole @default(mitra)
  noTelepon String?  @map("no_telepon") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  lahan Lahan[]

  @@index([authId])
  @@index([role])
  @@map("users")
}

model Lahan {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  nama       String   @db.VarChar(255)
  lokasi     String?
  luasHektar Decimal  @map("luas_hektar") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  siklusTanam   SiklusTanam[]
  jadwalIrigasi JadwalIrigasi[]

  @@index([userId])
  @@map("lahan")
}

model SiklusTanam {
  id                 String         @id @default(uuid()) @db.Uuid
  lahanId            String         @map("lahan_id") @db.Uuid
  varietas           VarietasJagung
  tanggalTanam       DateTime       @map("tanggal_tanam") @db.Date
  estimasiPanen      DateTime       @map("estimasi_panen") @db.Date
  tanggalPanenAktual DateTime?      @map("tanggal_panen_aktual") @db.Date
  status             StatusSiklus   @default(perencanaan)
  catatan            String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  lahan         Lahan          @relation(fields: [lahanId], references: [id], onDelete: Cascade)
  hasilPanen    HasilPanen[]
  biayaPanen    BiayaPanen[]
  jadwalIrigasi JadwalIrigasi[]

  @@index([lahanId])
  @@index([status])
  @@map("siklus_tanam")
}

model HasilPanen {
  id              String   @id @default(uuid()) @db.Uuid
  siklusTanamId   String   @map("siklus_tanam_id") @db.Uuid
  tanggalPanen    DateTime @map("tanggal_panen") @db.Date
  jumlahKg        Decimal  @map("jumlah_kg") @db.Decimal(10, 2)
  kualitas        String?  @db.VarChar(50)
  hargaPerKg      Decimal? @map("harga_per_kg") @db.Decimal(12, 2)
  totalPendapatan Decimal? @map("total_pendapatan") @db.Decimal(15, 2)
  catatan         String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  siklusTanam SiklusTanam @relation(fields: [siklusTanamId], references: [id], onDelete: Cascade)

  @@index([siklusTanamId])
  @@map("hasil_panen")
}

model BiayaPanen {
  id            String        @id @default(uuid()) @db.Uuid
  siklusTanamId String        @map("siklus_tanam_id") @db.Uuid
  kategori      KategoriBiaya
  deskripsi     String?
  jumlah        Decimal       @db.Decimal(15, 2)
  tanggal       DateTime      @db.Date
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  siklusTanam SiklusTanam @relation(fields: [siklusTanamId], references: [id], onDelete: Cascade)

  @@index([siklusTanamId])
  @@index([kategori])
  @@map("biaya_panen")
}

model JadwalIrigasi {
  id            String        @id @default(uuid()) @db.Uuid
  lahanId       String        @map("lahan_id") @db.Uuid
  siklusTanamId String?       @map("siklus_tanam_id") @db.Uuid
  tanggalWaktu  DateTime      @map("tanggal_waktu") @db.Timestamptz()
  durasiMenit   Int           @map("durasi_menit")
  volumeLiter   Decimal?      @map("volume_liter") @db.Decimal(10, 2)
  status        StatusIrigasi @default(dijadwalkan)
  catatan       String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  lahan       Lahan        @relation(fields: [lahanId], references: [id], onDelete: Cascade)
  siklusTanam SiklusTanam? @relation(fields: [siklusTanamId], references: [id], onDelete: SetNull)

  @@index([lahanId])
  @@index([siklusTanamId])
  @@index([status])
  @@index([tanggalWaktu])
  @@map("jadwal_irigasi")
}

model VarietasRef {
  id        String         @id @default(uuid()) @db.Uuid
  nama      VarietasJagung @unique
  hariPanen Int            @map("hari_panen")
  deskripsi String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  @@map("varietas_ref")
}
